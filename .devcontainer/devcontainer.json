// Entorno Codespaces para HuellitasSV (API .NET 10 + app movil Expo).
// La base de datos es MonsterASP (nube); no se levanta SQL local.
{
  "name": "HuellitasSV",
  "image": "mcr.microsoft.com/dotnet/sdk:10.0",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },
  "forwardPorts": [5299, 8081],
  "portsAttributes": {
    "5299": { "label": "API HuellitasSV", "onAutoForward": "openBrowser" },
    "8081": { "label": "Metro (app movil)", "onAutoForward": "notify" }
  },
  "postCreateCommand": "bash .devcontainer/setup-sqlserver.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "humao.rest-client",
        "dbaeumer.vscode-eslint"
      ]
    }
  },
  "remoteEnv": {
    "ASPNETCORE_ENVIRONMENT": "Development"
  }
}
