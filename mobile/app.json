{
  "expo": {
    "name": "HuellitasSV",
    "slug": "HuellitasSV",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.huellitassv.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "HuellitasSV necesita acceso a tus fotos para subir imágenes de mascotas.",
          "cameraPermission": "HuellitasSV necesita acceso a la cámara para tomar fotos."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "HuellitasSV usa tu ubicación para reportar animales en situación de calle."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4e69c0d6-ed40-464c-90f8-efc5a31d43cf"
      }
    }
  }
}